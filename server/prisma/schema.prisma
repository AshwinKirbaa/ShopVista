generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  cart      Cart?
  orders    Order[]
  reviews   Review[]
  priceAlerts   PriceAlert[]
  searchHistory SearchHistory[]

  @@index([email])
  @@map("users")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String  @default("India")
  isDefault    Boolean @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  image       String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  description   String
  price         Decimal @db.Decimal(10, 2)
  comparePrice  Decimal? @db.Decimal(10, 2)
  sku           String  @unique
  stock         Int     @default(0)
  images        String[] 
  categoryId    String
  isActive      Boolean @default(true)
  isFeatured    Boolean @default(false)
  rating        Decimal @default(0) @db.Decimal(2, 1)
  reviewCount   Int     @default(0)

  category   Category    @relation(fields: [categoryId], references: [id])
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([isActive, isFeatured])
  @@index([price])
  @@map("products")
}

model Cart {
  id     String @id @default(cuid())
  userId String @unique

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  addressId       String?
  status          OrderStatus   @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  shippingCharge  Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  
  // Shipping info snapshot
  shippingName    String
  shippingPhone   String
  shippingAddress String
  shippingCity    String
  shippingState   String
  shippingPincode String
  
  notes           String?

  user            User              @relation(fields: [userId], references: [id])
  address         Address?          @relation(fields: [addressId], references: [id])
  items           OrderItem[]
  payment         Payment?
  statusHistory   OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  productName  String
  productImage String?
  productSlug  String?
  price        Decimal @db.Decimal(10, 2)
  quantity     Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                  String        @id @default(cuid())
  orderId             String        @unique
  method              PaymentMethod @default(RAZORPAY)
  status              PaymentStatus @default(PENDING)
  amount              Decimal       @db.Decimal(10, 2)
  currency            String        @default("INR")
  razorpayOrderId     String?       @unique
  razorpayPaymentId   String?       @unique
  razorpaySignature   String?
  failureReason       String?
  paidAt              DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([razorpayOrderId])
  @@index([status])
  @@map("payments")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model Review {
  id        String  @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

// ==========================================
// MULTI-PLATFORM PRICE COMPARISON ENGINE MODELS
// ==========================================

model Marketplace {
  id           String   @id @default(cuid())
  name         String   @unique // e.g. "Amazon India", "Flipkart", "Croma", "Reliance Digital", "ShopVista Store"
  slug         String   @unique // "amazon-in", "flipkart", "croma", "reliance-digital", "shopvista"
  logoUrl      String
  websiteUrl   String
  affiliateTag String?
  isActive     Boolean  @default(true)
  isInternal   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products     MarketplaceProduct[]
  offers       ProductOffer[]
  priceHistory PriceHistory[]

  @@map("marketplaces")
}

model MarketplaceProduct {
  id            String   @id @default(cuid())
  marketplaceId String
  externalId    String?  // ASIN / FSN / Retailer SKU
  title         String
  slug          String
  brand         String
  model         String?
  gtin          String?  // UPC / EAN
  storage       String?  // "128GB", "256GB", "512GB", "1TB"
  ram           String?  // "8GB", "12GB", "16GB"
  color         String?
  condition     String   @default("NEW") // "NEW", "REFURBISHED", "OPEN_BOX"
  url           String
  imageUrl      String?
  lastScrapedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  marketplace   Marketplace        @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  offers        ProductOffer[]
  matchItems    ProductMatchItem[]
  priceHistory  PriceHistory[]

  @@index([marketplaceId])
  @@index([brand])
  @@index([model])
  @@index([gtin])
  @@index([storage])
  @@map("marketplace_products")
}

model ProductOffer {
  id                   String   @id @default(cuid())
  marketplaceProductId String
  marketplaceId        String
  mrp                  Decimal  @db.Decimal(10, 2)
  sellingPrice         Decimal  @db.Decimal(10, 2)
  shippingCharge       Decimal  @default(0) @db.Decimal(10, 2)
  finalPrice           Decimal  @db.Decimal(10, 2) // sellingPrice + shippingCharge
  currency             String   @default("INR")
  inStock              Boolean  @default(true)
  deliveryTime         String?  // e.g. "Tomorrow by 11 AM", "2-3 business days"
  sellerName           String?
  sellerRating         Decimal? @db.Decimal(2, 1)
  couponDetails        String?
  isVerified           Boolean  @default(true)
  condition            String   @default("NEW")
  productUrl           String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  marketplaceProduct   MarketplaceProduct @relation(fields: [marketplaceProductId], references: [id], onDelete: Cascade)
  marketplace          Marketplace        @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)
  priceHistory         PriceHistory[]

  @@index([marketplaceProductId])
  @@index([marketplaceId])
  @@index([finalPrice])
  @@index([inStock])
  @@map("product_offers")
}

model ProductMatch {
  id             String   @id @default(cuid())
  groupKey       String   @unique // e.g. "apple-iphone-17-pro-256gb-new"
  canonicalTitle String   // "Apple iPhone 17 Pro (256GB, Titanium)"
  brand          String   // "Apple"
  model          String   // "iPhone 17 Pro"
  category       String   // "Smartphones"
  variant        String   // "256GB"
  color          String?
  condition      String   @default("NEW")
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items          ProductMatchItem[]
  priceAlerts    PriceAlert[]

  @@index([brand])
  @@index([model])
  @@index([variant])
  @@map("product_matches")
}

model ProductMatchItem {
  id                   String   @id @default(cuid())
  productMatchId       String
  marketplaceProductId String
  matchConfidence      Decimal  @db.Decimal(3, 2) // 1.00 for exact, 0.85 for high-confidence fuzzy
  matchReason          String?

  productMatch         ProductMatch       @relation(fields: [productMatchId], references: [id], onDelete: Cascade)
  marketplaceProduct   MarketplaceProduct @relation(fields: [marketplaceProductId], references: [id], onDelete: Cascade)

  @@unique([productMatchId, marketplaceProductId])
  @@index([marketplaceProductId])
  @@map("product_match_items")
}

model PriceHistory {
  id                   String   @id @default(cuid())
  offerId              String?
  marketplaceProductId String
  marketplaceId        String
  price                Decimal  @db.Decimal(10, 2)
  recordedAt           DateTime @default(now())

  offer                ProductOffer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  marketplaceProduct   MarketplaceProduct  @relation(fields: [marketplaceProductId], references: [id], onDelete: Cascade)
  marketplace          Marketplace         @relation(fields: [marketplaceId], references: [id], onDelete: Cascade)

  @@index([marketplaceProductId])
  @@index([marketplaceId])
  @@index([recordedAt])
  @@map("price_history")
}

model PriceAlert {
  id                String    @id @default(cuid())
  userId            String
  productMatchId    String
  targetPrice       Decimal   @db.Decimal(10, 2)
  initialPrice      Decimal   @db.Decimal(10, 2)
  currentPrice      Decimal   @db.Decimal(10, 2)
  notificationEmail String
  isActive          Boolean   @default(true)
  triggeredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productMatch      ProductMatch @relation(fields: [productMatchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productMatchId])
  @@index([isActive])
  @@map("price_alerts")
}

model SearchHistory {
  id           String   @id @default(cuid())
  userId       String?
  query        String
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([createdAt])
  @@map("search_history")
}
