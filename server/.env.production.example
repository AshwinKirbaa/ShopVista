# ==============================================================================
# SHOPVISTA BACKEND — PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# ==============================================================================
# DO NOT commit the filled .env.production file containing real secrets to Git.
# Store production secrets in a dedicated secrets manager (AWS Secrets Manager,
# GCP Secret Manager, Vault, or your hosting platform's encrypted environment).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 14+ with SSL)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require&schema=public
DATABASE_URL="postgresql://shopvista_prod:CHANGE_TO_STRONG_PASSWORD@db-prod.internal:5432/shopvista_db?sslmode=require&schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET="GENERATE_A_64_CHARACTER_CRYPTOGRAPHICALLY_RANDOM_SECRET_KEY"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 4. CORS & CLIENT DOMAIN
# ------------------------------------------------------------------------------
# Must match your public production frontend HTTPS domain:
CLIENT_URL="https://shopvista.example.com"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (Razorpay Production Live Credentials)
# ------------------------------------------------------------------------------
# Obtain from https://dashboard.razorpay.com/#/app/keys (Live Mode)
RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="REPLACE_WITH_LIVE_KEY_SECRET"
# Configured in Razorpay Webhooks settings targeting: https://api.shopvista.example.com/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET="REPLACE_WITH_WEBHOOK_SECRET"

# ------------------------------------------------------------------------------
# 6. MULTI-PLATFORM MARKETPLACE AFFILIATE / DATA APIS
# ------------------------------------------------------------------------------
# Amazon India Product Advertising API (PA-API v5):
# Obtain via Amazon Associates India portal: https://affiliate-program.amazon.in/
AMAZON_PAAPI_KEY=""
AMAZON_PAAPI_SECRET=""
AMAZON_ASSOCIATE_TAG="shopvista-21"
AMAZON_REGION="eu-west-1"

# Flipkart Affiliate Search API:
# Obtain via Flipkart Affiliate Program: https://affiliate.flipkart.com/
FLIPKART_AFFILIATE_ID=""
FLIPKART_AFFILIATE_TOKEN=""

# Authorized Retailer Partner Keys (Optional direct B2B integrations):
CROMA_API_KEY=""
RELIANCE_API_KEY=""

# ------------------------------------------------------------------------------
# 7. INITIAL ADMIN CREDENTIALS (Seeded on initial database setup only)
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@shopvista.example.com"
ADMIN_PASSWORD="CHANGE_TO_INITIAL_STRONG_ADMIN_PASSWORD"
ADMIN_NAME="System Administrator"
